rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    match /receipt_images/{userId}/{allPaths=**} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;

      // Sin límite de tamaño ni de tipo, la ruta era un hosting de archivos
      // gratis a costa del proyecto.
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|heic|webp)');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
