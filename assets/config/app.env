# Configuracion de la app. SE VERSIONA a proposito.
#
# Este archivo se empaqueta dentro del binario (APK/IPA/web), asi que
# cualquiera puede leerlo. NO PONER SECRETOS ACA NUNCA.
# Las claves de proveedores de IA viven en el proxy server-side.
#
# Para sobreescribir en local sin tocar el repo, usa --dart-define.

APP_ENV=development

# Localizacion: formato de dinero, fechas y lectura de tickets
APP_LOCALE=es_UY
CURRENCY_CODE=UYU
DATE_DAY_FIRST=true

# OCR: 'local' usa ML Kit on-device (default y recomendado).
# 'ollama' usa un modelo de vision, y solo funciona con Ollama accesible
# por red: en un telefono real localhost es el propio telefono.
OCR_PROVIDER=local
OCR_CONFIDENCE_THRESHOLD=0.7

# Estructuracion del texto OCR con IA. Cuando esta en false se usa
# solamente el parser de regex.
ENABLE_AI_STRUCTURING=true
ENABLE_AI_CLASSIFICATION=true
ENABLE_AI_INSIGHTS=true

# Subida de la foto a Firebase Storage. Apagado: Storage exige plan Blaze y
# este proyecto esta en Spark, asi que la subida fallaba siempre y hacia
# esperar hasta 45 segundos en cada guardado. La foto se guarda en Firestore.
ENABLE_CLOUD_STORAGE=false

# Proveedor de IA. En produccion apunta al proxy server-side.
AI_PROVIDER=ollama
AI_PROXY_BASE_URL=

# Ollama (solo desarrollo local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_OCR_MODEL=glm-ocr:latest
