rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Dueño del documento YA existente.
    function owns() {
      return signedIn() && request.auth.uid == resource.data.userId;
    }

    // Dueño del documento que se está escribiendo.
    function claimsOwnership() {
      return signedIn() && request.auth.uid == request.resource.data.userId;
    }

    // El userId nunca puede cambiar: sin esto, un update podía reasignar
    // un documento propio a otra cuenta (o robar uno ajeno vía create+update).
    function userIdIsImmutable() {
      return request.resource.data.userId == resource.data.userId;
    }

    // Montos en CENTAVOS enteros, no en pesos con decimales.
    // El techo son 10.000 millones de centavos = 100 millones de pesos.
    // Antes eran 100 millones de "algo": al pasar a centavos ese mismo numero
    // habria significado un millon de pesos, un techo mucho mas bajo de lo
    // que parecia. Es exactamente el tipo de regla que cambia de significado
    // en silencio cuando cambia la unidad.
    function isMoneyCents(v) {
      return v is int && v >= 0 && v <= 10000000000;
    }

    // ---- Grupos: autorizacion por PERTENENCIA, no por dueño ----
    //
    // Un gasto compartido no tiene un dueño, asi que el modelo
    // `uid == resource.data.userId` del resto de la app no aplica.

    function grupoDe(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    // Que la escritura agregue al que la hace, y a NADIE mas.
    //
    // Se chequea el tamaño ademas de `hasAll` porque `hasAll` sola dejaria
    // pasar que se agreguen varios de una: uno se agrega a si mismo y de paso
    // mete a tres amigos, o peor, agrega a alguien a un grupo ajeno.
    function soloMeAgregoAMi() {
      return request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.size() ==
             resource.data.memberIds.size() + 1
        && request.auth.uid in request.resource.data.memberIds
        // Solo puede aparecer SU entrada nueva en el mapa de miembros.
        && request.resource.data.members.diff(resource.data.members)
             .affectedKeys() == [request.auth.uid].toSet();
    }

    function inviteValido(token, groupId) {
      return token is string
        && exists(/databases/$(database)/documents/invites/$(token))
        && get(/databases/$(database)/documents/invites/$(token)).data.groupId
             == groupId
        && get(/databases/$(database)/documents/invites/$(token)).data.expiresAt
             > request.time;
    }

    function esDelGrupo(groupId) {
      return signedIn() && request.auth.uid in grupoDe(groupId).memberIds;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;

      // Sin este wildcard, cualquier subcolección futura queda sin proteger.
      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    match /receipts/{receiptId} {
      allow get, list: if owns();
      allow create: if claimsOwnership()
        && isMoneyCents(request.resource.data.totalCents)
        && request.resource.data.status in ['pending', 'processing', 'completed', 'failed'];
      allow update: if owns() && claimsOwnership() && userIdIsImmutable()
        && isMoneyCents(request.resource.data.totalCents);
      allow delete: if owns();

      // Miniatura del ticket en base64. Vive aparte para que la lista de
      // tickets no la arrastre en cada snapshot: son decenas de KB por ticket.
      // Lleva su propio userId, asi la regla no necesita leer el ticket padre
      // (cada get() dentro de una regla es una lectura facturada).
      match /media/{mediaId} {
        allow get: if owns();
        allow create: if claimsOwnership()
          && request.resource.data.data is string
          && request.resource.data.data.size() < 700000;
        allow update: if owns() && claimsOwnership() && userIdIsImmutable();

        // `resource == null` es un documento que no existe, y borrarlo es una
        // operacion nula. Sin este caso, `owns()` evaluaba
        // `resource.data.userId` sobre null, la evaluacion abortaba y denegaba.
        //
        // Importa porque el borrado de un ticket es un batch ATOMICO que
        // incluye esta miniatura sin condicion. Si la miniatura nunca se pudo
        // generar (un HEIC del carrete que `package:image` no decodifica), el
        // batch entero se caia: el ticket quedaba imposible de borrar para
        // siempre, y su gasto seguia sumando en el dashboard y contra el
        // presupuesto, sin ninguna salida desde la app.
        allow delete: if signedIn() && (resource == null || owns());
      }
    }

    match /expenses/{expenseId} {
      allow get, list: if owns();
      allow create: if claimsOwnership()
        && isMoneyCents(request.resource.data.amountCents)
        && request.resource.data.date is timestamp;
      allow update: if owns() && claimsOwnership() && userIdIsImmutable()
        && isMoneyCents(request.resource.data.amountCents);
      allow delete: if owns();
    }

    match /budgets/{budgetId} {
      allow get, list: if owns();
      allow create: if claimsOwnership() && isMoneyCents(request.resource.data.limitCents);
      allow update: if owns() && claimsOwnership() && userIdIsImmutable();
      allow delete: if owns();
    }

    match /insights/{insightId} {
      allow get, list: if owns();
      // create faltaba por completo: escribir un insight fallaba siempre.
      allow create: if claimsOwnership();
      allow update: if owns() && claimsOwnership() && userIdIsImmutable();
      allow delete: if owns();
    }

    match /groups/{groupId} {
      function esMiembro() {
        return signedIn() && request.auth.uid in resource.data.memberIds;
      }
      function seraMiembro() {
        return signedIn() && request.auth.uid in request.resource.data.memberIds;
      }

      allow get, list: if esMiembro();

      // Al crear solo te podes poner a vos. Meter a otros sin que acepten es
      // spam, y sumar gente es trabajo del link de invitacion.
      allow create: if seraMiembro()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;

      // Un miembro puede renombrar o archivar, pero NO tocar la membresia:
      // ni sumar a nadie, ni sacar a nadie.
      allow update: if esMiembro() && seraMiembro()
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.currency == resource.data.currency;

      // Sumarse a un grupo con un link de invitacion.
      //
      // Quien todavia no es miembro solo puede hacer UNA cosa: agregarse a si
      // mismo, exactamente a si mismo, y solo si el token del link es valido.
      // Todo lo demas del documento tiene que quedar igual.
      //
      // El token ES la credencial: quien lo tiene, entra. Por eso vence.
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && soloMeAgregoAMi()
        && inviteValido(request.resource.data.inviteToken, groupId)
        // Nada mas del grupo puede cambiar en la misma escritura.
        && request.resource.data.name == resource.data.name
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if signedIn()
        && request.auth.uid == resource.data.createdBy;

      match /expenses/{expenseId} {
        // Autoriza mirando el GRUPO, no una copia dentro del gasto.
        //
        // El diseño original desnormalizaba memberIds en cada gasto para no
        // pagar un get(). Se cambio por dos motivos:
        //
        // 1. La copia queda VIEJA cuando alguien se suma al grupo, asi que el
        //    que entra no veria ningun gasto anterior, y no puede arreglarlo
        //    el mismo: para actualizarlos necesitaria listarlos, que es justo
        //    lo que la regla le niega.
        // 2. Esta condicion no menciona `resource`, asi que Firestore la
        //    evalua UNA VEZ para toda la consulta y no una vez por documento.
        //    O sea una lectura extra en total, no una por gasto: el ahorro que
        //    justificaba la copia no era tal.
        //
        // Efecto secundario bueno: la query no necesita ningun filtro para
        // pasar, que es el error de permission-denied que ya se choco una vez.
        allow get, list: if esDelGrupo(groupId);

        // LIMITE CONOCIDO: no se valida que `shares` ni `paidBy` sumen
        // `amountCents`. No es un olvido: el lenguaje de reglas no tiene forma
        // de sumar los valores de un mapa (no hay sum ni reduce, y .values()
        // solo da una List sin operaciones aritmeticas). Guardar un total
        // redundante no ayuda: un cliente malicioso mentiria tambien ahi.
        //
        // Quien valida es el cliente (GroupExpenseEntity.isBalanced, chequeado
        // en GroupRepository.addExpense antes de escribir). Mientras el grupo
        // tenga una sola persona el riesgo es cero. Con mas gente, un miembro
        // podria escribir un reparto que no cierra y torcer los saldos; por eso
        // la UI marca los gastos descuadrados en vez de sumarlos en silencio.
        //
        // Arreglarlo de verdad necesita validacion server-side, o sea Cloud
        // Functions, o sea plan Blaze.

        // Escribir SI verifica contra el grupo de verdad. Sin esto cualquiera
        // podria crear un gasto en un grupo ajeno declarandose miembro en la
        // copia, y no habria forma de detectarlo. Escribir es raro comparado
        // con leer, asi que la lectura extra por gasto es barata.
        allow create: if esDelGrupo(groupId)
          && request.resource.data.createdBy == request.auth.uid
          && isMoneyCents(request.resource.data.amountCents)
          && request.resource.data.amountCents > 0
          && request.resource.data.date is timestamp;

        allow update: if esDelGrupo(groupId)
          && isMoneyCents(request.resource.data.amountCents)
          && request.resource.data.amountCents > 0;

        allow delete: if esDelGrupo(groupId);
      }
    }

    // Links de invitacion a un grupo.
    //
    // Se puede LEER cualquier invite estando logueado, a proposito: el token es
    // un UUID imposible de adivinar y es la credencial misma. Quien tiene el
    // link puede leerlo; quien no, no puede enumerarlos (`list` esta denegado).
    //
    // El invite solo dice a que grupo pertenece y cuando vence. No expone
    // gastos, ni saldos, ni quienes son los miembros.
    match /invites/{token} {
      allow get: if signedIn();
      allow list: if false;

      // Solo un miembro del grupo puede crear un link para ese grupo, y no
      // puede fabricar uno que no venza.
      allow create: if esDelGrupo(request.resource.data.groupId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time;

      // No se editan: se crea uno nuevo o se borra este.
      allow update: if false;
      allow delete: if signedIn()
        && request.auth.uid == resource.data.createdBy;
    }

    // Todo lo no declarado queda denegado explícitamente.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
